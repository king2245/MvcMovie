
@model IEnumerable<MvcMovie.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

<p>
    <a asp-controller="Movies"
       asp-action="Create"
       class="btn btn-success">
        Create New Movie
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Release Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
           
<tr>
    <td>@movie.Title</td>
    <td>@movie.Genre</td>
    <td>@movie.Price</td>
    <td>@movie.ReleaseDate.ToString("yyyy-MM-dd")</td>
    <td>
        <a asp-controller="Movies"
           asp-action="Edit"
           asp-route-id="@movie.Id">Edit</a>
           
<a asp-controller="Movies"
   asp-action="Delete"
   asp-route-id="@movie.Id"
   class="btn btn-danger">Delete</a>

    </td>
</tr>

        }
    </tbody>
</table>
