@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to MvcMovie</h1>
    <p class="lead">Your home for discovering movies.</p>

    <hr />

    <h2>Explore Movies</h2>
    <p>Discover movies, learn about them, and find your next favourite.</p>

    <a class="btn btn-primary" href="/Movies">
        Explore Movies
    </a>
        <br />
    <br />

    <a class="btn btn-success"
       asp-controller="Movies"
       asp-action="Create">
        Create New Movie
    </a>
</div>
